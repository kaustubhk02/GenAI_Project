# Copy this file to backend/.env and edit. NEVER commit the real .env file.
NODE_ENV=development
PORT=5000

# Local MongoDB (Community Server or Docker). For Atlas, paste your mongodb+srv:// string.
MONGODB_URI=mongodb://127.0.0.1:27017/farmer_scheme_platform

# Generate a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Python OCR service (python-services/ocr-service)
OCR_SERVICE_URL=http://127.0.0.1:8001

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Allow .txt uploads so the synthetic sample documents work without OCR. Set false in production.
ALLOW_TEXT_UPLOADS=true
